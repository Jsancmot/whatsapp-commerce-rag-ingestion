# Environment: LOCAL | DEVELOPMENT | PREPRO | PRODUCTION
ENVIRONMENT=LOCAL

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_commerce

# OpenAI (required for DEVELOPMENT / PREPRO / PRODUCTION)
OPENAI_API_KEY=

# Ollama (used in LOCAL environment)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Vector store
COLLECTION_NAME=whatsapp_commerce_rag

# Scheduler: set to 0 to run once and exit, or N minutes to loop
SCHEDULE_INTERVAL_MINUTES=0
